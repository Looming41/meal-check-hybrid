    "test:rules": "node test/rules.test.mjs",
    "test:integration": "node test/integration.test.mjs",
    "test:ui": "node test/ui.test.mjs",
    "test:dist": "node test/dist.test.mjs",
    "test:proxy": "node test/proxy.test.mjs",
    "test:clip": "node test/clip-smoke.mjs"
  },
  "devDependencies": {
    "jsdom": "^26.0.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "3.7.5"
  }
}
